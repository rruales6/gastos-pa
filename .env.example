# Base de datos Postgres (Neon). En Vercel se agrega sola al conectar Neon desde Storage.
# Si se deja vacía en local, la app usa una base embebida en la carpeta .pglite
DATABASE_URL=

# Clave larga y aleatoria para firmar las sesiones (ej: openssl rand -hex 32)
AUTH_SECRET=

# Contraseña de cada hermano
PASSWORD_RICARDO=
PASSWORD_CARLOS=
PASSWORD_VICTOR=
